# ============================================================
#  RISET-AI — konfigurasi Vercel + Supabase
#  Semua nilai ini di-set di: Vercel → Project → Settings → Environment Variables
# ============================================================

# ==== DATABASE (Supabase Postgres) ====
# Untuk RUNTIME di Vercel (serverless) → pakai POOLER (Supavisor, port 6543, host *-pooler):
#   Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"

# Untuk MIGRASI (prisma db push dari laptop/CI) → koneksi LANGSUNG (port 5432):
#   Project Settings → Database → Connection string → "Direct connection"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# ==== SUPABASE API (untuk Storage upload docx/gambar) ====
# Project Settings → API. NEXT_PUBLIC_* aman di-expose ke browser (anon key).
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Storage: jalankan supabase/setup.sql sekali (SQL Editor Supabase)
# untuk membuat bucket "uploads" + policy anon INSERT/SELECT.

# ==== CATATAN ====
# - Kunci Gemini/API AI TIDAK di-set di env — diisi lewat halaman /settings
#   aplikasi (disimpan di database Supabase, hanya hidup di server).
# - Export PDF (LibreOffice) tidak tersedia di Vercel — tombolnya akan memberi
#   pesan jelas; gunakan Export DOCX lalu konversi lokal.
# - Upload dari browser langsung ke Supabase Storage (melewati limit body Vercel).
