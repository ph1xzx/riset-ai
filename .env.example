# Riset AI — environment
# Secret untuk tanda tangan session cookie (WAJIB di production)
AUTH_SECRET=ganti-dengan-32-karakter-acak

# Lokasi data (default: ./data)
# DATA_DIR=/var/lib/riset-ai
# STORAGE_DIR=/var/lib/riset-ai/storage

# Vercel: set untuk runtime serverless (opsional)
# VERCEL=1
# VERCEL_REGION=iad1
